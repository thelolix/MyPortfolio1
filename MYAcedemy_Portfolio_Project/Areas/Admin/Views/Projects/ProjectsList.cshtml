@model List<MYAcedemy_Portfolio_Project.Entites.Project>
@{
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
@{
    int sayac = 0;
}

<div class="container">
    <br />

    <h3>Projelerim </h3>
    <br />

    <table class="table table-bordered table-hover">
        <tr>
            <th>#</th>
            <th>Proje Adı</th>
            <th>Kategori Adı</th>
            <th>Proje Acıklaması</th>
            <th>GitHub Linklerim</th>
            <th>Foto</th>
            <th>Categoryler</th>
            <th>Güncelle</th>
            <th>Sil</th>
        </tr>
        <tbody>
            @foreach (var item in Model)
            {
                sayac = sayac + 1;
                <tr>
                    <td>@sayac</td>
                    <td>@item.Title</td>
                    <td>@item.Category.CategoryName</td>
                    <td>@item.Description</td>
                    <td>@item.GitHubUrl</td>
                    <td>@item.CoverImageurl</td>
                    <td>@item.CategoryID</td>
                    <td>

                        <a href="/Admin/Projects/UpdateProjects/@item.ProjectID" class="btn btn-success btn-sm">Güncelle</a>
                    </td>
                    <td>

                        <a href="/Admin/Projects/DeleteProjects/@item.ProjectID" class="btn btn-danger btn-sm">Sil</a>
                    </td>

                </tr>
            }
        </tbody>
    </table>
    <a href="/Admin/Projects/CreateProjects/" class="btn btn-primary">Yeni Proje Ekle</a>

</div>