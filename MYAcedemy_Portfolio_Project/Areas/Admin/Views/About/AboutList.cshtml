@model List<MYAcedemy_Portfolio_Project.Entites.About>
@{
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
@{
    int sayac = 0;
}

<div class="container">
    <br />

        <h3>Hakkımda Listesi</h3>
    <br />

    <table class="table table-bordered table-hover">
            <tr>
                <th>#</th>
                <th>Ad Soyad</th>
                <th>Unvan</th>
                <th>Lokasyon</th>
                <th>Uzmanlık</th>
                <th>E-posta</th>
                <th>Açıklama</th>
                <th>Çalışma Durumu</th>
                <th>Güncelle</th>
                <th>Sil</th>
            </tr>
        <tbody>
            @foreach (var item in Model)
            {
                sayac = sayac + 1;
                <tr>
                    <td>@sayac</td>
                    <td>@item.NameSurname</td>
                    <td>@item.JobTitle</td>
                    <td>@item.Location</td>
                    <td>@item.Expert</td>
                    <td>@item.Email</td>
                    <td>@item.Description</td>
                    <td>@item.OpenToWork</td>
                    <td>
  
                        <a href="/Admin/About/AboutUpdate/@item.AboutID" class="btn btn-success btn-sm">Güncelle</a>
                    </td>
                    <td>

                        <a href="/Admin/About/AboutDelete/@item.AboutID" class="btn btn-danger btn-sm">Sil</a>
                    </td>

                </tr>
            }
        </tbody>
    </table>
    <a href="/Admin/About/AboutCreate" class="btn btn-primary">Yeni Hakkımda Ekle</a>

</div>