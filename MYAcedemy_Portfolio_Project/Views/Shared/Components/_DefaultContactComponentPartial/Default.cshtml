@{
    Layout = null;
}

<section id="contact" style="background-color: var(--bg-secondary);">
    <div class="container">

        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">İLETİŞİME GEÇELİM</span>
            <h2 class="section-title">Birlikte Harika İşler Üretebiliriz.</h2>
            <p class="section-subtitle">
                Yeni projeler, iş birlikleri veya yalnızca merhaba demek için benimle iletişime geçebilirsiniz.
            </p>
        </div>

        <div class="row g-5 align-items-start">

            <!-- SOL TARAF: İLETİŞİM BİLGİLERİ -->
            <div class="col-lg-5 reveal-on-scroll">
                <div class="contact-info-card">
                    <h4 class="fs-4 fw-bold mb-3">İletişim Bilgileri</h4>

                    <p class="text-secondary mb-4">
                        Aşağıdaki iletişim kanallarından bana ulaşabilirsin.
                        En kısa sürede dönüş sağlayacağım.
                    </p>

                    <div class="contact-item">
                        <div class="contact-icon bg-icon-purple">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <div>
                            <div class="text-secondary small">E-posta</div>
                            <a href="mailto:mustafatalha311@gmail.com"
                               class="text-decoration-none fw-bold text-dark">
                                mustafatalha311@gmail.com
                            </a>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon bg-icon-blue">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <div>
                            <div class="text-secondary small">Konum</div>
                            <div class="fw-bold text-dark">İstanbul, Türkiye</div>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon bg-icon-mint">
                            <i class="bi bi-linkedin"></i>
                        </div>
                        <div>
                            <div class="text-secondary small">LinkedIn</div>
                            <a href="https://www.linkedin.com/in/mustafa-talha-y%C4%B1lmaz-11bb49255/"
                               target="_blank"
                               class="text-decoration-none fw-bold text-dark">
                                LinkedIn Profilim
                            </a>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon bg-icon-peach">
                            <i class="bi bi-github"></i>
                        </div>
                        <div>
                            <div class="text-secondary small">GitHub</div>
                            <a href="https://github.com/thelolix"
                               target="_blank"
                               class="text-decoration-none fw-bold text-dark">
                                github.com/thelolix
                            </a>
                        </div>
                    </div>

                    <div class="mt-4 p-3 rounded-4 bg-white border">
                        <i class="bi bi-clock-history text-primary"></i>
                        Genellikle 24 saat içinde yanıt verilir.
                    </div>
                </div>
            </div>

            <!-- SAĞ TARAF: MESAJ FORMU -->
            <div class="col-lg-7 reveal-on-scroll">

                @if (TempData["MessageSuccess"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show"
                         role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @TempData["MessageSuccess"]
                        <button type="button" class="btn-close"
                                data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="contact-info-card">
                    <h4 class="fs-4 fw-bold mb-3">Bana Mesaj Gönder</h4>

                    <form action="/Default/SendMessage"
                          method="post"
                          id="contactForm">

                        @Html.AntiForgeryToken()

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label">Adınız Soyadınız</label>
                                <input type="text"
                                       name="NameSurname"
                                       class="form-control"
                                       placeholder="Adınız Soyadınız"
                                       required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">E-posta</label>
                                <input type="email"
                                       name="Email"
                                       class="form-control"
                                       placeholder="E-posta adresiniz"
                                       required>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Konu</label>
                                <input type="text"
                                       name="Subject"
                                       class="form-control"
                                       placeholder="Mesajınızın konusu"
                                       required>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Mesajınız</label>
                                <textarea name="MessageDetail"
                                          class="form-control"
                                          rows="6"
                                          placeholder="Mesajınızı buraya yazın..."
                                          required></textarea>
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit"
                                        class="btn-custom-primary w-100">
                                    <i class="bi bi-send-fill me-2"></i>
                                    Mesaj Gönder
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>

        </div>
    
</section>
