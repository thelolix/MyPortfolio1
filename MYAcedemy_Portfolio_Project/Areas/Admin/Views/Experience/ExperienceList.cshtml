@model List<MYAcedemy_Portfolio_Project.Entites.Experience>

@{
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container">
    <br />
    <table class="table table-bordered">
        <tr>
            <th>#</th>
            <th>Başlık</th>
            <th>Şirket Adı</th>
            <th>Açıklama</th>
            <th>Alt Başlık</th>
            <th>Süre / Zaman</th>
            <th>Çalışma Türü</th>
            <th>Sil</th>
            <th>Güncelle</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ExperienceID</td>
                <td>@item.ExperienceTitle</td>
                <td>@item.SideTitle</td>
                <td>@item.Duration</td>
                <td>@item.IsActive</td>
                <td><a href="/Admin/Experience/DeleteExperience/@item.ExperienceID" class="btn btn-danger">Sil</a></td>
                <td><a href="/Admin/Experience/UpdateExperience/@item.ExperienceID" class="btn btn-success">Güncelle</a></td>
                <td>Güncelle</td>
            </tr>
        }
    </table>
</div>