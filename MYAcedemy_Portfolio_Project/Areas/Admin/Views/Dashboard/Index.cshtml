@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    int total = ViewBag.messageCount ?? 0;
    int readCount = ViewBag.messageReadeByTrueCount ?? 0;
    int unreadCount = ViewBag.messageReadeByFalseCount ?? 0;
    int readPercent = total > 0 ? (int)Math.Round(readCount * 100.0 / total) : 0;
    int unreadPercent = total > 0 ? 100 - readPercent : 0;

    int allProject = ViewBag.allProject ?? 0;
    int activeProject = ViewBag.activeProject ?? 0;
    int allSkills = ViewBag.allSkills ?? 0;
    int allExperience = ViewBag.allExperience ?? 0;
    int allEducation = ViewBag.allEducation ?? 0;

    var lastMessages = ViewBag.lastMessages as List<MYAcedemy_Portfolio_Project.Entites.Message>;
    var lastProjects = ViewBag.lastProjects as List<MYAcedemy_Portfolio_Project.Entites.Project>;
    var categorySummary = ViewBag.categorySummary;
}

<style>
    :root {
        --primary: #6366f1;
        --primary-dark: #4f46e5;
        --primary-light: #a5b4fc;
        --secondary: #0ea5e9;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --surface: #ffffff;
        --surface-2: #f8fafc;
        --border: #e2e8f0;
        --text: #0f172a;
        --text-muted: #64748b;
        --text-light: #94a3b8;
        --shadow-sm: 0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.04);
        --shadow-md: 0 4px 16px rgba(0,0,0,.08), 0 2px 6px rgba(0,0,0,.04);
        --shadow-lg: 0 10px 40px rgba(0,0,0,.1), 0 4px 12px rgba(0,0,0,.05);
        --radius: 16px;
        --radius-sm: 10px;
        --radius-xs: 6px;
    }

    .db {
        font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
        color: var(--text);
        padding: 0 2px 32px;
        min-height: 100vh;
    }

        .db * {
            box-sizing: border-box;
        }

    /* ─── HERO BANNER ─── */
    .db-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 40%, #6366f1 100%);
        border-radius: var(--radius);
        padding: 32px 36px;
        margin-bottom: 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        position: relative;
        overflow: hidden;
    }

        .db-hero::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 240px;
            height: 240px;
            background: rgba(255,255,255,.08);
            border-radius: 50%;
        }

        .db-hero::after {
            content: '';
            position: absolute;
            bottom: -80px;
            right: 120px;
            width: 180px;
            height: 180px;
            background: rgba(255,255,255,.05);
            border-radius: 50%;
        }

    .db-hero-left h1 {
        font-size: 26px;
        font-weight: 700;
        color: #fff;
        margin: 0 0 6px;
    }

    .db-hero-left p {
        color: rgba(255,255,255,.75);
        font-size: 14px;
        margin: 0;
    }

    .db-hero-badges {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        position: relative;
        z-index: 1;
    }

    .hero-badge {
        background: rgba(255,255,255,.18);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.25);
        color: #fff;
        border-radius: 99px;
        padding: 7px 16px;
        font-size: 13px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* ─── STAT GRID ─── */
    .db-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .db-stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px;
        box-shadow: var(--shadow-sm);
        display: flex;
        align-items: center;
        gap: 16px;
        transition: transform .2s, box-shadow .2s;
        position: relative;
        overflow: hidden;
    }

        .db-stat::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: var(--radius) var(--radius) 0 0;
        }

        .db-stat:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
        }

        .db-stat.indigo::after {
            background: linear-gradient(90deg, #6366f1, #818cf8);
        }

        .db-stat.green::after {
            background: linear-gradient(90deg, #10b981, #34d399);
        }

        .db-stat.sky::after {
            background: linear-gradient(90deg, #0ea5e9, #38bdf8);
        }

        .db-stat.amber::after {
            background: linear-gradient(90deg, #f59e0b, #fbbf24);
        }

        .db-stat.purple::after {
            background: linear-gradient(90deg, #8b5cf6, #a78bfa);
        }

        .db-stat.rose::after {
            background: linear-gradient(90deg, #f43f5e, #fb7185);
        }

    .db-stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .ic-indigo {
        background: #eef2ff;
    }

    .ic-green {
        background: #ecfdf5;
    }

    .ic-sky {
        background: #f0f9ff;
    }

    .ic-amber {
        background: #fffbeb;
    }

    .ic-purple {
        background: #f5f3ff;
    }

    .ic-rose {
        background: #fff1f2;
    }

    .db-stat-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: .04em;
        margin: 0 0 4px;
    }

    .db-stat-value {
        font-size: 30px;
        font-weight: 800;
        margin: 0;
        line-height: 1;
    }

    .db-stat-sub {
        font-size: 11px;
        color: var(--text-light);
        margin-top: 4px;
    }

    /* ─── SECTION GRID ─── */
    .db-row {
        display: grid;
        gap: 20px;
        margin-bottom: 24px;
    }

    .db-row-2 {
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    }

    .db-row-3 {
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }

    /* ─── CARD ─── */
    .db-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 24px;
        box-shadow: var(--shadow-sm);
    }

    .db-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .db-card-title {
        font-size: 15px;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .db-card-title span.icon {
            width: 28px;
            height: 28px;
            background: #eef2ff;
            border-radius: 7px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

    .db-card-link {
        font-size: 12px;
        font-weight: 600;
        color: var(--primary);
        text-decoration: none;
        background: #eef2ff;
        padding: 5px 12px;
        border-radius: 99px;
        transition: background .15s;
    }

        .db-card-link:hover {
            background: #e0e7ff;
            color: var(--primary-dark);
        }

    /* ─── PROGRESS BARS ─── */
    .prog-row {
        margin-bottom: 16px;
    }

        .prog-row:last-child {
            margin-bottom: 0;
        }

    .prog-top {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 8px;
    }

        .prog-top .pct {
            font-weight: 700;
            color: var(--text-muted);
        }

    .prog-track {
        height: 10px;
        background: var(--surface-2);
        border-radius: 99px;
        overflow: hidden;
        border: 1px solid var(--border);
    }

    .prog-fill {
        height: 100%;
        border-radius: 99px;
        transition: width .6s cubic-bezier(.4,0,.2,1);
    }

    .pf-green {
        background: linear-gradient(90deg, #10b981, #34d399);
    }

    .pf-amber {
        background: linear-gradient(90deg, #f59e0b, #fbbf24);
    }

    .pf-indigo {
        background: linear-gradient(90deg, #6366f1, #818cf8);
    }

    /* ─── DONUT ─── */
    .donut-section {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 32px;
        flex-wrap: wrap;
        padding: 8px 0;
    }

    .donut-chart {
        position: relative;
        width: 160px;
        height: 160px;
        flex-shrink: 0;
    }

    .donut-svg {
        transform: rotate(-90deg);
        width: 160px;
        height: 160px;
    }

    .donut-bg {
        fill: none;
        stroke: #f1f5f9;
        stroke-width: 18;
    }

    .donut-read {
        fill: none;
        stroke: #10b981;
        stroke-width: 18;
        stroke-linecap: round;
        transition: stroke-dasharray .6s;
    }

    .donut-unread {
        fill: none;
        stroke: #f59e0b;
        stroke-width: 18;
        stroke-linecap: round;
    }

    .donut-label {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .donut-label strong {
            font-size: 26px;
            font-weight: 800;
            color: var(--text);
        }

        .donut-label small {
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 500;
        }

    .donut-legend {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .donut-legend li {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
            font-size: 14px;
        }

            .donut-legend li:last-child {
                margin-bottom: 0;
            }

    .leg-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .leg-info strong {
        display: block;
        font-size: 15px;
        font-weight: 700;
    }

    .leg-info span {
        font-size: 12px;
        color: var(--text-muted);
    }

    /* ─── BAR CHART ─── */
    .bar-chart {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .bar-meta {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 5px;
    }

        .bar-meta .bar-count {
            font-weight: 700;
            color: var(--primary);
            background: #eef2ff;
            padding: 1px 8px;
            border-radius: 99px;
            font-size: 12px;
        }

    .bar-track {
        height: 10px;
        background: #f1f5f9;
        border-radius: 99px;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #6366f1, #818cf8);
        border-radius: 99px;
        transition: width .6s cubic-bezier(.4,0,.2,1);
    }

    /* ─── TABLE ─── */
    .db-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .db-table thead th {
            padding: 10px 14px;
            text-align: left;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--text-muted);
            background: var(--surface-2);
            border-bottom: 1px solid var(--border);
        }

            .db-table thead th:first-child {
                border-radius: var(--radius-sm) 0 0 0;
            }

            .db-table thead th:last-child {
                border-radius: 0 var(--radius-sm) 0 0;
            }

        .db-table td {
            padding: 13px 14px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .db-table tr:last-child td {
            border-bottom: none;
        }

        .db-table tbody tr {
            transition: background .15s;
        }

            .db-table tbody tr:hover td {
                background: #fafbff;
            }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 13px;
        flex-shrink: 0;
    }

    .name-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .name-cell .n {
            font-weight: 600;
            font-size: 14px;
        }

        .name-cell .e {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 1px;
        }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 99px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-read {
        background: #ecfdf5;
        color: #047857;
    }

    .badge-unread {
        background: #fef3c7;
        color: #b45309;
    }

    .badge-indigo {
        background: #eef2ff;
        color: #4338ca;
    }

    .table-scroll {
        overflow-x: auto;
        border-radius: var(--radius-sm);
    }

    /* ─── QUICK LINKS ─── */
    .quick-links {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .ql-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 14px;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text);
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        background: var(--surface-2);
        transition: all .18s;
    }

        .ql-item:hover {
            border-color: var(--primary);
            background: #eef2ff;
            color: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

        .ql-item .ql-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #fff;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }

    /* ─── ACTIVITY ─── */
    .activity-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .activity-list li {
            display: flex;
            gap: 14px;
            padding: 12px 0;
            border-bottom: 1px solid #f1f5f9;
            align-items: flex-start;
        }

            .activity-list li:last-child {
                border-bottom: none;
            }

    .act-dot-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 4px;
    }

    .act-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .act-line {
        width: 2px;
        flex: 1;
        background: #f1f5f9;
        margin-top: 4px;
    }

    .activity-list li:last-child .act-line {
        display: none;
    }

    .act-title {
        font-size: 14px;
        font-weight: 500;
        color: var(--text);
    }

    .act-time {
        font-size: 12px;
        color: var(--text-light);
        margin-top: 2px;
        display: block;
    }

    /* ─── SECTION LABEL ─── */
    .section-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--text-muted);
        margin-bottom: 12px;
        padding-left: 2px;
    }

    @@media (max-width: 600px) {
        .db-hero {
            padding: 22px 20px;
        }

        .db-hero-left h1 {
            font-size: 20px;
        }

        .db-stats {
            grid-template-columns: 1fr 1fr;
        }

        .db-stat-value {
            font-size: 24px;
        }

        .quick-links {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="db">

    <!-- ═══ HERO ═══ -->
    <div class="db-hero">
        <div class="db-hero-left">
            <h1>👋 Hoş Geldiniz!</h1>
            <p>Portfolyo panelinize genel bakış — tüm istatistikler anlık olarak güncelleniyor.</p>
        </div>
        <div class="db-hero-badges">
            <span class="hero-badge">📁 @allProject Proje</span>
            <span class="hero-badge">✉ @total Mesaj</span>
            <span class="hero-badge">🔔 @unreadCount Okunmamış</span>
        </div>
    </div>

    <!-- ═══ STAT CARDS ═══ -->
    <p class="section-label">Genel İstatistikler</p>
    <div class="db-stats">

        <div class="db-stat indigo">
            <div class="db-stat-icon ic-indigo">📁</div>
            <div>
                <p class="db-stat-label">Toplam Proje</p>
                <p class="db-stat-value">@allProject</p>
                <div class="db-stat-sub">Sistemdeki tüm projeler</div>
            </div>
        </div>

        <div class="db-stat green">
            <div class="db-stat-icon ic-green">🟢</div>
            <div>
                <p class="db-stat-label">Aktif Proje</p>
                <p class="db-stat-value">@activeProject</p>
                <div class="db-stat-sub">Yayında olan projeler</div>
            </div>
        </div>

        <div class="db-stat sky">
            <div class="db-stat-icon ic-sky">🛠</div>
            <div>
                <p class="db-stat-label">Yetenek</p>
                <p class="db-stat-value">@allSkills</p>
                <div class="db-stat-sub">Kayıtlı beceriler</div>
            </div>
        </div>

        <div class="db-stat amber">
            <div class="db-stat-icon ic-amber">💼</div>
            <div>
                <p class="db-stat-label">Deneyim</p>
                <p class="db-stat-value">@allExperience</p>
                <div class="db-stat-sub">İş & kariyer kaydı</div>
            </div>
        </div>

        <div class="db-stat purple">
            <div class="db-stat-icon ic-purple">🎓</div>
            <div>
                <p class="db-stat-label">Eğitim</p>
                <p class="db-stat-value">@allEducation</p>
                <div class="db-stat-sub">Okul & kurs kaydı</div>
            </div>
        </div>

        <div class="db-stat sky">
            <div class="db-stat-icon ic-sky">✉</div>
            <div>
                <p class="db-stat-label">Toplam Mesaj</p>
                <p class="db-stat-value">@total</p>
                <div class="db-stat-sub">Tüm zamanlar</div>
            </div>
        </div>

        <div class="db-stat rose">
            <div class="db-stat-icon ic-rose">🔔</div>
            <div>
                <p class="db-stat-label">Okunmamış</p>
                <p class="db-stat-value">@unreadCount</p>
                <div class="db-stat-sub">Bekleyen mesajlar</div>
            </div>
        </div>

    </div>

    <!-- ═══ MESAJ DURUMU + DONUT ═══ -->
    <p class="section-label">Mesaj Analizi</p>
    <div class="db-row db-row-2">

        <div class="db-card">
            <div class="db-card-header">
                <h3 class="db-card-title"><span class="icon">📊</span> Mesaj Durumu</h3>
            </div>
            <div class="prog-row">
                <div class="prog-top"><span>✅ Okunmuş</span><span class="pct">@readCount / @total — %@readPercent</span></div>
                <div class="prog-track"><div class="prog-fill pf-green" style="width:@(readPercent)%"></div></div>
            </div>
            <div class="prog-row">
                <div class="prog-top"><span>⏳ Okunmamış</span><span class="pct">@unreadCount / @total — %@unreadPercent</span></div>
                <div class="prog-track"><div class="prog-fill pf-amber" style="width:@(unreadPercent)%"></div></div>
            </div>
            <div class="prog-row" style="margin-top:20px;">
                <div class="prog-top"><span>📬 Toplam Doluluk</span><span class="pct">%100</span></div>
                <div class="prog-track"><div class="prog-fill pf-indigo" style="width:100%"></div></div>
            </div>
        </div>

        <div class="db-card">
            <div class="db-card-header">
                <h3 class="db-card-title"><span class="icon">🍩</span> Okunma Oranı</h3>
            </div>
            <div class="donut-section">
                @{
                    double circumference = 2 * Math.PI * 62;
                    double readDash = circumference * readPercent / 100.0;
                    double unreadDash = circumference * unreadPercent / 100.0;
                }
                <div class="donut-chart">
                    <svg class="donut-svg" viewBox="0 0 160 160">
                        <circle class="donut-bg" cx="80" cy="80" r="62" />
                        <circle class="donut-read" cx="80" cy="80" r="62"
                                stroke-dasharray="@readDash.ToString("F2") @((circumference - readDash).ToString("F2"))"
                                stroke-dashoffset="0" />
                        <circle class="donut-unread" cx="80" cy="80" r="62"
                                stroke-dasharray="@unreadDash.ToString("F2") @((circumference - unreadDash).ToString("F2"))"
                                stroke-dashoffset="-@readDash.ToString("F2")" />
                    </svg>
                    <div class="donut-label">
                        <strong>%@readPercent</strong>
                        <small>okundu</small>
                    </div>
                </div>
                <ul class="donut-legend">
                    <li>
                        <span class="leg-dot" style="background:#10b981"></span>
                        <div class="leg-info"><strong>@readCount</strong><span>Okunmuş Mesaj</span></div>
                    </li>
                    <li>
                        <span class="leg-dot" style="background:#f59e0b"></span>
                        <div class="leg-info"><strong>@unreadCount</strong><span>Okunmamış Mesaj</span></div>
                    </li>
                    <li>
                        <span class="leg-dot" style="background:#6366f1"></span>
                        <div class="leg-info"><strong>@total</strong><span>Toplam Mesaj</span></div>
                    </li>
                </ul>
            </div>
        </div>

    </div>

    <!-- ═══ KATEGORİ DAĞILIMI ═══ -->
    <p class="section-label">Proje Kategorileri</p>
    <div class="db-row db-row-2">

        <div class="db-card">
            <div class="db-card-header">
                <h3 class="db-card-title"><span class="icon">📂</span> Kategori Listesi</h3>
            </div>
            <div class="table-scroll">
                <table class="db-table">
                    <thead><tr><th>Kategori Adı</th><th style="text-align:right;">Adet</th></tr></thead>
                    <tbody>
                        @if (categorySummary != null)
                        {
                            foreach (var cat in categorySummary)
                            {
                                <tr>
                                    <td><strong>@cat.CategoryName</strong></td>
                                    <td style="text-align:right;"><span class="badge badge-indigo">@cat.ProjectCount proje</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="2" style="text-align:center;color:#9ca3af;padding:24px;">Kategori verisi bulunamadı.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="db-card">
            <div class="db-card-header">
                <h3 class="db-card-title"><span class="icon">📈</span> Görsel Dağılım</h3>
            </div>
            <div class="bar-chart">
                @if (categorySummary != null)
                {
                    int maxCat = 1;
                    foreach (var cat in categorySummary) { if ((int)cat.ProjectCount > maxCat) maxCat = (int)cat.ProjectCount; }
                    foreach (var cat in categorySummary)
                    {
                        int pct = (int)Math.Round((double)cat.ProjectCount / maxCat * 100);
                        <div class="bar-row">
                            <div class="bar-meta"><span>@cat.CategoryName</span><span class="bar-count">@cat.ProjectCount</span></div>
                            <div class="bar-track"><div class="bar-fill" style="width:@(pct)%"></div></div>
                        </div>
                    }
                }
            </div>
        </div>

    </div>

    <!-- ═══ SON MESAJLAR ═══ -->
    <p class="section-label">Son Aktivite</p>
    <div class="db-card" style="margin-bottom:24px;">
        <div class="db-card-header">
            <h3 class="db-card-title"><span class="icon">✉</span> Son Mesajlar</h3>
            <a class="db-card-link" href="/Admin/Message/MessageList">Tümünü gör →</a>
        </div>
        <div class="table-scroll">
            <table class="db-table">
                <thead>
                    <tr><th>Gönderen</th><th>Konu</th><th>Tarih</th><th>Durum</th></tr>
                </thead>
                <tbody>
                    @if (lastMessages != null && lastMessages.Count > 0)
                    {
                        foreach (var item in lastMessages)
                        {
                            string initials = "MS";
                            if (!string.IsNullOrEmpty(item.NameSurname))
                            {
                                var parts = item.NameSurname.Split(' ');
                                if (parts.Length > 1) initials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
                                else if (parts[0].Length > 1) initials = parts[0].Substring(0, 2).ToUpper();
                            }
                            <tr>
                                <td>
                                    <div class="name-cell">
                                        <span class="avatar">@initials</span>
                                        <div><div class="n">@item.NameSurname</div><div class="e">@item.Email</div></div>
                                    </div>
                                </td>
                                <td style="font-weight:500;">@item.Subject</td>
                                <td style="color:var(--text-muted);font-size:13px;">@item.SendDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @if (item.IsRead)
                                    {
                                        <span class="badge badge-read">✔ Okundu</span>
                                    }
                                    else
                                    {

                                        <span class="badge badge-unread">⏳ Okunmadı</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" style="text-align:center;color:#9ca3af;padding:24px;">Henüz hiç mesaj bulunmuyor.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ═══ SON PROJELER ═══ -->
    <div class="db-card" style="margin-bottom:24px;">
        <div class="db-card-header">
            <h3 class="db-card-title"><span class="icon">📁</span> Son Projeler</h3>
            <a class="db-card-link" href="/Admin/Projects/ProjectsList">Tümünü gör →</a>
        </div>
        <div class="table-scroll">
            <table class="db-table">
                <thead>
                    <tr><th>#</th><th>Proje Başlığı</th><th>Kategori</th><th>Görsel</th></tr>
                </thead>
                <tbody>
                    @if (lastProjects != null && lastProjects.Count > 0)
                    {
                        foreach (var project in lastProjects)
                        {
                            <tr>
                                <td style="color:var(--text-muted);font-size:13px;">#@project.ProjectID</td>
                                <td><strong>@project.Title</strong></td>
                                <td><span class="badge badge-indigo">@(project.Category?.CategoryName ?? "Kategorisiz")</span></td>
                                <td>
                                    <a href="@project.CoverImageurl" target="_blank"
                                       style="color:var(--primary);font-size:13px;font-weight:500;text-decoration:none;">
                                        🖼 Görüntüle
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" style="text-align:center;color:#9ca3af;padding:24px;">Henüz kayıtlı bir proje bulunmuyor.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ═══ AKTİVİTE + HIZLI ERİŞİM ═══ -->
    <div class="db-row db-row-2">

        <div class="db-card">
            <div class="db-card-header">
                <h3 class="db-card-title"><span class="icon">⚡</span> Son Aktiviteler</h3>
            </div>
            <ul class="activity-list">
                <li>
                    <div class="act-dot-wrap"><span class="act-dot" style="background:#6366f1"></span><div class="act-line"></div></div>
                    <div><div class="act-title">Panel başarıyla yüklendi</div><span class="act-time">Şu an aktif</span></div>
                </li>
                <li>
                    <div class="act-dot-wrap"><span class="act-dot" style="background:#10b981"></span><div class="act-line"></div></div>
                    <div><div class="act-title">Veritabanı bağlantısı sağlandı</div><span class="act-time">Tüm veriler senkronize</span></div>
                </li>
                <li>
                    <div class="act-dot-wrap"><span class="act-dot" style="background:#f59e0b"></span></div>
                    <div><div class="act-title">@unreadCount okunmamış mesaj bekliyor</div><span class="act-time">Mesajlar sayfasından kontrol edin</span></div>
                </li>
            </ul>
        </div>

        <div class="db-card">
            <div class="db-card-header">
                <h3 class="db-card-title"><span class="icon">🔗</span> Hızlı Erişim</h3>
            </div>
            <div class="quick-links">
                <a class="ql-item" href="/Admin/Projects/ProjectsList"><span class="ql-icon">📁</span> Projeler</a>
                <a class="ql-item" href="/Admin/Skills/SkillList"><span class="ql-icon">🛠</span> Yetenekler</a>
                <a class="ql-item" href="/Admin/Experience/ExperienceList"><span class="ql-icon">💼</span> Deneyimler</a>
                <a class="ql-item" href="/Admin/Education/EducationList"><span class="ql-icon">🎓</span> Eğitim</a>
                <a class="ql-item" href="/Admin/About/AboutList"><span class="ql-icon">👤</span> Hakkımda</a>
                <a class="ql-item" href="/Admin/Message/MessageList"><span class="ql-icon">✉</span> Mesajlar</a>
            </div>
        </div>

    </div>

</div>