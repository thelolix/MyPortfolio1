<aside id="sidebar-wrapper">

    <!-- BRAND -->
    <div class="sidebar-brand">
        <div class="d-flex align-items-center gap-2">
            <div class="brand-mark">P</div>
            <div>
                <div class="fw-bold text-white lh-1" style="font-family:'Plus Jakarta Sans';font-size:0.95rem;">Mustafa Talha.</div>
                <small class="text-white-50" style="font-size:0.7rem;">Portfolio Admin</small>
            </div>
        </div>
    </div>

    <!-- NAV -->
    <div class="sidebar-nav-scroll">

        <div class="nav-group-title">Genel</div>

        <a href="/Admin/Dashboard/Index"
           class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
            <i class="bi bi-speedometer2"></i><span>Dashboard</span>
        </a>

        <a href="/" target="_blank" class="sidebar-link">
            <i class="bi bi-box-arrow-up-right"></i><span>Siteyi Görüntüle</span>
        </a>

        <div class="nav-group-title">İçerik</div>

        <a href="/Admin/About/Index"
           class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "About" ? "active" : "")">
            <i class="bi bi-person"></i><span>Hakkımda</span>
        </a>

        <a href="/Admin/Education/Index"
           class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Education" ? "active" : "")">
            <i class="bi bi-mortarboard"></i><span>Eğitim</span>
        </a>

        <a href="/Admin/Experience/ExperienceList"
           class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Experience" ? "active" : "")">
            <i class="bi bi-briefcase"></i><span>Deneyimler</span>
        </a>

        <a href="/Admin/Skills/SkillList"
           class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Skills" ? "active" : "")">
            <i class="bi bi-code-slash"></i><span>Yetenekler</span>
        </a>

        <a href="/Admin/Projects/ProjectsList"
           class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active" : "")">
            <i class="bi bi-grid"></i><span>Projeler</span>
        </a>

        <!-- EKSİK OLAN KATEGORİLER EKLENDİ -->
        <a href="/Admin/Category/CategoryList"
           class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")">
            <i class="bi bi-tag"></i><span>Kategoriler</span>
        </a>

        <div class="nav-group-title">İletişim & Sistem</div>

        <a href="/Admin/Message/MessageList"
           class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Message" ? "active" : "")">
            <i class="bi bi-envelope"></i>
            <span>Mesajlar</span>
            @if (ViewBag.unreadMessageCount != null && (int)ViewBag.unreadMessageCount > 0)
            {
                <span class="ms-auto badge rounded-pill"
                      style="background:#f59e0b;font-size:10px;padding:3px 7px;">
                    @ViewBag.unreadMessageCount
                </span>
            }
        </a>

        <a href="/Admin/SocialMedia/SocialMediaList"
           class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SocialMedia" ? "active" : "")">
            <i class="bi bi-share"></i><span>Sosyal Medya</span>
        </a>

        <a href="/Admin/Setting/Index"
           class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Setting" ? "active" : "")">
            <i class="bi bi-gear"></i><span>Ayarlar</span>
        </a>

    </div>

    <!-- FOOTER PROMO BOX -->
    <div class="sidebar-footer-box">
        <div class="d-flex align-items-center gap-2 mb-2">
            <div style="width:28px;height:28px;border-radius:8px;background:rgba(162,148,249,.2);display:flex;align-items:center;justify-content:center;">
                <i class="bi bi-stars" style="color:#A294F9;font-size:.9rem;"></i>
            </div>
            <span style="font-size:.78rem;font-weight:700;color:#fff;">Portfolio CMS</span>
        </div>
        <p style="font-size:.72rem;color:rgba(220,226,245,.6);margin:0 0 10px;line-height:1.5;">
            Tüm içeriklerinizi tek panelden yönetin.
        </p>

        <!-- KULLANICI KARTI VE DÜZGÜN HİZALANMIŞ ÇIKIŞ BUTONU -->
        <div class="sidebar-user-card d-flex align-items-center justify-content-between" style="margin:0;padding:10px 12px;border-radius:10px;">
            <div class="d-flex align-items-center gap-2 overflow-hidden">
                <div class="sidebar-user-avatar mb-0">MY</div>
                <div class="overflow-hidden" style="min-width:0;">
                    <div class="fw-semibold text-white text-truncate" style="font-size:.8rem;">Mustafa Talha Yılmaz</div>
                    <div style="font-size:.68rem;color:#B3BFDF;">Yönetici</div>
                </div>
            </div>
            <a href="/Login/Logout"
               class="text-white-50"
               title="Çıkış Yap"
               style="font-size:1.1rem;line-height:1;text-decoration:none;transition:color .15s;flex-shrink:0;padding-left:8px;"
               onmouseover="this.style.color='#f87171'"
               onmouseout="this.style.color=''">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>

</aside>