
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

@await Component.InvokeAsync("_DefaultHeadComponentPartial")


<body data-bs-spy="scroll" data-bs-target="#mainNavbar" data-bs-offset="100">

    @await Component.InvokeAsync("_DefaultNavbarComponentPartial")

    @await Component.InvokeAsync("_DefaultHeroSectionCopmonentPartial")

    <!-- Infinite Soft Marquee for Technologies -->
    <div class="marquee-container">
        <div class="marquee-track">
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> C# .NET</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> ASP.NET Core</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Microsoft SQL Server</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Entity Framework Core</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> RESTful API Design</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Clean Architecture</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Bootstrap 5</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> JavaScript (ES6+)</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Docker & Git</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> PostgreSQL</div>
            <!-- Duplicate for seamless infinite loop -->
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> C# .NET</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> ASP.NET Core</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Microsoft SQL Server</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Entity Framework Core</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> RESTful API Design</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Clean Architecture</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Bootstrap 5</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> JavaScript (ES6+)</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Docker & Git</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> PostgreSQL</div>
        </div>
    </div>

    @await Component.InvokeAsync("_DefaultAboutComponentPartial")
    @await Component.InvokeAsync("_DefaultEducationComponentPartial")
    @await Component.InvokeAsync("_DefaultExperienceComponentPartial")
    <!-- Technical Skills Section -->
    <section id="skills" style="background-color: var(--bg-secondary);">
        <div class="container">
            <div class="text-center mb-5 reveal-on-scroll">
                <span class="section-eyebrow">TEKNİK YETKİNLİKLER</span>
                <h2 class="section-title">Yeteneklerim</h2>
                <p class="section-subtitle">Fikirleri çalışan yazılımlara dönüştürürken kullandığım teknolojiler.</p>
            </div>

            <div class="row g-4">
                <!-- 1. Backend Development -->
                <div class="col-lg-4 col-md-6 reveal-on-scroll">
                    <div class="skill-group-card">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="float-icon-box bg-icon-purple">
                                <i class="bi bi-hdd-network"></i>
                            </div>
                            <h4 class="fs-5 fw-bold mb-0">Backend Development</h4>
                        </div>
                        <p class="text-secondary small mb-3">Güvenli, modüler ve yüksek performanslı sunucu taraflı mimariler.</p>
                        <div class="d-flex flex-wrap">
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> C#</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> ASP.NET Core</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> Web API</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> EF Core</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> LINQ</span>
                        </div>
                    </div>
                </div>

                <!-- 2. Frontend Development -->
                <div class="col-lg-4 col-md-6 reveal-on-scroll">
                    <div class="skill-group-card">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="float-icon-box bg-icon-blue">
                                <i class="bi bi-browser-chrome"></i>
                            </div>
                            <h4 class="fs-5 fw-bold mb-0">Frontend Development</h4>
                        </div>
                        <p class="text-secondary small mb-3">Erişilebilir, duyarlı ve temiz kullanıcı arayüzleri.</p>
                        <div class="d-flex flex-wrap">
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> HTML5</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> CSS3</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> JavaScript (ES6+)</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> Bootstrap 5</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> Responsive Design</span>
                        </div>
                    </div>
                </div>

                <!-- 3. Database Technologies -->
                <div class="col-lg-4 col-md-6 reveal-on-scroll">
                    <div class="skill-group-card">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="float-icon-box bg-icon-mint">
                                <i class="bi bi-database"></i>
                            </div>
                            <h4 class="fs-5 fw-bold mb-0">Database Technologies</h4>
                        </div>
                        <p class="text-secondary small mb-3">İlişkisel modelleme, sorgu optimizasyonu ve veri bütünlüğü.</p>
                        <div class="d-flex flex-wrap">
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> MS SQL Server</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> PostgreSQL</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> MongoDB</span>
                        </div>
                    </div>
                </div>

                <!-- 4. Tools & Practices -->
                <div class="col-lg-6 col-md-6 reveal-on-scroll">
                    <div class="skill-group-card">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="float-icon-box bg-icon-peach">
                                <i class="bi bi-tools"></i>
                            </div>
                            <h4 class="fs-5 fw-bold mb-0">Tools & Practices</h4>
                        </div>
                        <p class="text-secondary small mb-3">Modern DevOps araçları, sürüm kontrolü ve çevik çalışma kültürü.</p>
                        <div class="d-flex flex-wrap">
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> Git & GitHub</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> Docker</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> Postman</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> Swagger</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> Agile / Scrum</span>
                        </div>
                    </div>
                </div>

                <!-- 5. Software Architecture -->
                <div class="col-lg-6 col-md-12 reveal-on-scroll">
                    <div class="skill-group-card">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="float-icon-box bg-icon-purple">
                                <i class="bi bi-diagram-3"></i>
                            </div>
                            <h4 class="fs-5 fw-bold mb-0">Software Architecture</h4>
                        </div>
                        <p class="text-secondary small mb-3">Sürdürülebilir, test edilebilir ve endüstri standardı prensipler.</p>
                        <div class="d-flex flex-wrap">
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> OOP (Nesne Yönelimli)</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> SOLID Principles</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> Clean Architecture</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> RESTful API Design</span>
                            <span class="skill-chip"><i class="bi bi-check text-success"></i> Design Patterns</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @await Component.InvokeAsync("_DefaultProjectComponentPartial")

    @await Component.InvokeAsync("_DefaultCertifikaComponentPartial")

    <!-- Contact Section -->
    @await Component.InvokeAsync("_DefaultContactComponentPartial")
    @await Component.InvokeAsync("_DefaultFooterComponentPartial")
    <!-- Scroll To Top Button -->
    <button id="scrollToTopBtn" class="scroll-to-top" aria-label="Sayfanın Başına Çık">
        <i class="bi bi-chevron-up"></i>
    </button>

   

    @await Component.InvokeAsync("_DefaultScriptComponentPartial");
</body>
</html>