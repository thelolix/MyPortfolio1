@{
    Layout = null;

    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var pageTitle = ViewData["Title"]?.ToString() ?? action;

    string Active(string ctrl) =>
        string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@pageTitle | Portfolyo Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            :root {
                --sidebar-bg: #343B5C;
                --sidebar-surface: #424B70;
                --sidebar-active: #59658D;
                --sidebar-text: #DCE2F5;
                --sidebar-border: rgba(220, 226, 245, 0.08);
                --bg-main: #F6F7FC;
                --card-bg: #FFFFFF;
                --text-primary: #29344C;
                --text-secondary: #8490A5;
                --primary-accent: #8276D9;
                --primary-accent-hover: #7063cb;
                --border-color: #E9ECF4;
                --pastel-purple: #EEEAFE;
                --radius-md: 12px;
                --radius-lg: 16px;
                --shadow-subtle: 0 4px 20px rgba(41, 52, 76, 0.04);
                --sidebar-width: 260px;
                --transition-base: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            }

            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
                background-color: var(--bg-main);
                color: var(--text-primary);
                margin: 0;
                min-height: 100vh;
                overflow-x: hidden;
                font-size: 0.925rem;
            }

            h1, h2, h3, h4, h5, h6 {
                font-family: 'Plus Jakarta Sans', sans-serif;
                color: var(--text-primary);
                letter-spacing: -0.02em;
            }

            ::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            ::-webkit-scrollbar-thumb {
                background: #cfd6e4;
                border-radius: 4px;
            }

            /* ========== SIDEBAR ========== */
            #sidebar-wrapper {
                width: var(--sidebar-width);
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background: linear-gradient(180deg, #2a3058 0%, #343B5C 60%, #2e3457 100%);
                display: flex;
                flex-direction: column;
                z-index: 1040;
                box-shadow: 4px 0 30px rgba(22, 26, 45, 0.18);
                transition: transform 0.3s ease;
                border-right: 1px solid rgba(255,255,255,.04);
            }

            .sidebar-brand {
                padding: 20px 18px 16px;
                border-bottom: 1px solid var(--sidebar-border);
                display: flex;
                align-items: center;
                gap: 11px;
                text-decoration: none;
            }

            .brand-mark {
                width: 40px;
                height: 40px;
                background: linear-gradient(135deg, #A294F9 0%, #7664E8 100%);
                color: #fff;
                font-weight: 800;
                font-size: 1.15rem;
                border-radius: 12px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 4px 14px rgba(118, 100, 232, 0.4);
                flex-shrink: 0;
            }

            .sidebar-nav {
                flex: 1;
                overflow-y: auto;
                padding: 8px 12px 12px;
                scrollbar-width: none;
            }

                .sidebar-nav::-webkit-scrollbar {
                    display: none;
                }

            .nav-group-title {
                font-size: 0.65rem;
                font-weight: 700;
                letter-spacing: .1em;
                text-transform: uppercase;
                color: rgba(220,226,245,0.32);
                margin: 18px 10px 6px;
                padding-bottom: 6px;
                border-bottom: 1px solid rgba(255,255,255,.04);
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 9px 12px;
                margin-bottom: 2px;
                border-radius: var(--radius-md);
                color: rgba(220,226,245,0.78);
                text-decoration: none;
                font-size: 0.875rem;
                font-weight: 500;
                transition: var(--transition-base);
                position: relative;
                border-left: 3px solid transparent;
            }

                .sidebar-link i {
                    font-size: 1rem;
                    width: 20px;
                    text-align: center;
                    color: rgba(220,226,245,0.45);
                    flex-shrink: 0;
                    transition: var(--transition-base);
                }

                .sidebar-link:hover {
                    color: #fff;
                    background: rgba(255,255,255,.07);
                    border-left-color: rgba(162,148,249,.35);
                }

                    .sidebar-link:hover i {
                        color: #A294F9;
                    }

                .sidebar-link.active {
                    background: rgba(162,148,249,0.14);
                    color: #fff;
                    font-weight: 600;
                    border-left-color: #A294F9;
                }

                    .sidebar-link.active i {
                        color: #A294F9;
                    }

                    .sidebar-link.active::before {
                        display: none;
                    }

            .sidebar-divider {
                height: 1px;
                background: rgba(255,255,255,.06);
                margin: 6px 0;
            }

            .sidebar-user {
                margin: 0 12px 14px;
                padding: 11px 13px;
                background: rgba(255,255,255,.06);
                border-radius: var(--radius-md);
                border: 1px solid rgba(255,255,255,.07);
                display: flex;
                align-items: center;
                gap: 11px;
            }

            .user-avatar {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: linear-gradient(135deg, #8276D9, #a5b4fc);
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-weight: 700;
                font-size: 0.8rem;
                flex-shrink: 0;
            }

            /* ========== MAIN WRAPPER ========== */
            #main-content-wrapper {
                margin-left: var(--sidebar-width);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                min-width: 0;
                transition: margin-left 0.3s ease;
            }

            /* ========== NAVBAR ========== */
            .admin-navbar {
                height: 68px;
                background: rgba(255,255,255,0.94);
                backdrop-filter: blur(12px);
                border-bottom: 1px solid var(--border-color);
                position: sticky;
                top: 0;
                z-index: 1020;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 28px;
                gap: 16px;
            }

            .nav-icon-btn {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                border: 1px solid var(--border-color);
                background: #fff;
                color: var(--text-primary);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1.1rem;
                transition: var(--transition-base);
                text-decoration: none;
            }

                .nav-icon-btn:hover {
                    background: var(--pastel-purple);
                    color: var(--primary-accent);
                    border-color: #ddd6fc;
                }

            .nav-user-btn {
                display: flex;
                align-items: center;
                gap: 10px;
                border: none;
                background: transparent;
                padding: 4px;
                border-radius: 30px;
                cursor: pointer;
            }

            .dropdown-menu {
                border: 1px solid var(--border-color);
                border-radius: var(--radius-md);
                box-shadow: 0 14px 34px rgba(32,40,68,0.12);
                padding: 6px;
            }

            .dropdown-item {
                border-radius: 8px;
                padding: 8px 12px;
                font-size: 0.86rem;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .dropdown-item:hover {
                    background: #F2F4F9;
                    color: var(--primary-accent);
                }

            /* ========== PAGE HEADER ========== */
            .page-header {
                padding: 22px 28px 0;
            }

                .page-header h1 {
                    font-size: 1.35rem;
                    font-weight: 700;
                    margin: 0 0 4px;
                }

            .breadcrumb {
                margin: 0;
                font-size: 0.82rem;
            }

            .breadcrumb-item a {
                color: var(--text-secondary);
                text-decoration: none;
            }

                .breadcrumb-item a:hover {
                    color: var(--primary-accent);
                }

            .breadcrumb-item.active {
                color: var(--primary-accent);
                font-weight: 600;
            }

            .breadcrumb-item + .breadcrumb-item::before {
                content: "/";
                color: #C3CAD9;
            }

            /* ========== CONTENT ========== */
            .main-body-container {
                flex: 1;
                padding: 20px 28px 28px;
                min-width: 0;
            }

                .main-body-container .table {
                    background: var(--card-bg);
                }

                .main-body-container .table-responsive,
                .main-body-container table {
                    max-width: 100%;
                }

            .btn-primary {
                background-color: var(--primary-accent);
                border-color: var(--primary-accent);
            }

                .btn-primary:hover, .btn-primary:focus {
                    background-color: var(--primary-accent-hover);
                    border-color: var(--primary-accent-hover);
                }

            .form-control:focus, .form-select:focus {
                border-color: var(--primary-accent);
                box-shadow: 0 0 0 3px rgba(130,118,217,0.14);
            }

            /* ========== FOOTER ========== */
            .admin-footer {
                border-top: 1px solid var(--border-color);
                background: #fff;
                padding: 16px 28px;
                font-size: 0.8rem;
                color: var(--text-secondary);
                display: flex;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 8px;
            }

                .admin-footer a {
                    color: var(--text-secondary);
                    text-decoration: none;
                }

                    .admin-footer a:hover {
                        color: var(--primary-accent);
                    }

            /* ========== MOBILE ========== */
            .sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(22,26,45,0.45);
                z-index: 1035;
            }

            @@media (max-width: 991.98px) {
                #sidebar-wrapper {
                    transform: translateX(-100%);
                }

                body.sidebar-open #sidebar-wrapper {
                    transform: translateX(0);
                }

                body.sidebar-open .sidebar-overlay {
                    display: block;
                }

                #main-content-wrapper {
                    margin-left: 0;
                }

                .admin-navbar, .page-header, .main-body-container, .admin-footer {
                    padding-left: 16px;
                    padding-right: 16px;
                }
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ==================== SIDEBAR ==================== -->
    <aside id="sidebar-wrapper">

        <a href="/Admin" class="sidebar-brand">
            <div class="brand-mark">P</div>
            <div>
                <div class="fw-bold text-white lh-1" style="font-family:'Plus Jakarta Sans';font-size:.94rem;">Mustafa Talha.</div>
                <small class="text-white-50" style="font-size:.7rem;">Portfolio Admin</small>
            </div>
        </a>

        <nav class="sidebar-nav">

            <div class="nav-group-title">Genel</div>

            <a href="/Admin/Dashboard/Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>
            <a href="/Default/Index" target="_blank" class="sidebar-link">
                <i class="bi bi-box-arrow-up-right"></i><span>Siteyi Görüntüle</span>
            </a>

            <div class="nav-group-title">İçerik</div>

            <a href="/Admin/About/AboutList" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "About" ? "active" : "")">
                <i class="bi bi-person"></i><span>Hakkımda</span>
            </a>
            <a href="/Admin/Education/EducationList" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Education" ? "active" : "")">
                <i class="bi bi-mortarboard"></i><span>Eğitim</span>
            </a>
            <a href="/Admin/Experience/ExperienceList" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Experience" ? "active" : "")">
                <i class="bi bi-briefcase"></i><span>Deneyimler</span>
            </a>
            <a href="/Admin/Skills/SkillList" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Skills" ? "active" : "")">
                <i class="bi bi-code-slash"></i><span>Yetenekler</span>
            </a>
            <a href="/Admin/Projects/ProjectsList" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active" : "")">
                <i class="bi bi-grid"></i><span>Projeler</span>
            </a>
            <a href="/Admin/Category/CategoryList" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")">
                <i class="bi bi-tag"></i><span>Kategoriler</span>
            </a>

            <div class="nav-group-title">İletişim & Sistem</div>

            <a href="/Admin/Message/MessageList" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Message" ? "active" : "")">
                <i class="bi bi-envelope"></i><span>Mesajlar</span>
            </a>
            <a href="/Admin/SocialMedia/SocialList" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SocialMedia" ? "active" : "")">
                <i class="bi bi-share"></i><span>Sosyal Medya</span>
            </a>
            <a href="/Admin/Settings/Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")">
                <i class="bi bi-gear"></i><span>Ayarlar</span>
            </a>

            <div class="sidebar-divider"></div>


        </nav>

        <div class="sidebar-user">
            <div class="user-avatar">MY</div>
            <div class="overflow-hidden" style="min-width:0;flex:1;">
                <div class="fw-semibold text-white text-truncate" style="font-size:.82rem;">Mustafa Talha Yılmaz</div>
                <div style="font-size:.69rem;color:#B3BFDF;">Yönetici</div>
            </div>
            <a href="/Login/Logout"
               title="Çıkış"
               style="color:rgba(220,226,245,.35);font-size:1rem;text-decoration:none;transition:color .15s;flex-shrink:0;"
               onmouseover="this.style.color='#f87171'"
               onmouseout="this.style.color='rgba(220,226,245,.35)'">
                <i class="bi bi-power"></i>
            </a>
        </div>

    </aside>

    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

    <!-- ==================== MAIN ==================== -->
    <div id="main-content-wrapper">

        <header class="admin-navbar">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="nav-icon-btn d-lg-none" onclick="toggleSidebar()" aria-label="Menü">
                    <i class="bi bi-list"></i>
                </button>
                <span class="fw-semibold d-none d-sm-inline" style="font-family:'Plus Jakarta Sans';">Yönetim Paneli</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a href="/" target="_blank" class="nav-icon-btn" title="Siteyi Görüntüle">
                    <i class="bi bi-box-arrow-up-right"></i>
                </a>
                <a href="/Admin/Message/Index" class="nav-icon-btn" title="Mesajlar">
                    <i class="bi bi-envelope"></i>
                </a>
                <div class="dropdown">
                    <button class="nav-user-btn" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-avatar">MY</div>
                        <span class="fw-semibold d-none d-md-inline" style="font-size:0.85rem;">Mustafa Talha Yılmaz</span>
                        <i class="bi bi-chevron-down small text-secondary d-none d-md-inline"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/Admin/Profile/Index"><i class="bi bi-person-circle"></i> Profilim</a></li>
                        <li><a class="dropdown-item" href="/Admin/Setting/Index"><i class="bi bi-gear"></i> Ayarlar</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="/Login/Logout"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <div class="page-header">
            <h1>@pageTitle</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    @if (!string.IsNullOrEmpty(area))
                    {
                        <li class="breadcrumb-item">
                            <a href="/@area"><i class="bi bi-house-door me-1"></i>@area</a>
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(controller))
                    {
                        <li class="breadcrumb-item">
                            <a href="@(string.IsNullOrEmpty(area) ? "" : "/" + area)/@controller">@controller</a>
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(action))
                    {
                        <li class="breadcrumb-item active" aria-current="page">@action</li>
                    }
                </ol>
            </nav>
        </div>

        <main class="main-body-container">
            @RenderBody()
        </main>

        <footer class="admin-footer">
            <span>© @DateTime.Now.Year Poyraz. Portfolio Admin — Tüm hakları saklıdır.</span>
            <span>
                <a href="/" target="_blank">Siteyi Görüntüle</a>
                <span class="mx-2">•</span>
                <span>v1.0</span>
            </span>
        </footer>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            function toggleSidebar() {
                document.body.classList.toggle("sidebar-open");
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>