@model List<MYAcedemy_Portfolio_Project.Entites.Message>
@{
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}


<div class="container">
    <br />
    <table class="table table-bordered table-hover">
        <tr>
            <th>#</th>
            <th>Gönderici</th>
            <th>Email</th>
            <th>Konu</th>
            <th>Tarih</th>
            <th>Mesajı Aç</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MessageID</td>
                <td>@item.NameSurname</td>
                <td>@item.Email</td>
                <td>@item.Subject</td>
                <td>@item.SendDate.ToString("dd/MM/yyyy")</td>
                <td><a href="/Admin/Message/MessageDetail/@item.MessageID" class="btn btn-primary">Mesajı Görüntüle</a></td>
            </tr>
        }


    </table>
</div>

